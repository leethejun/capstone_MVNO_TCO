# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=alddle_db
MYSQL_USER=alddle_user
MYSQL_PASSWORD=your_password_here

# Backend Database URL
DATABASE_URL=mysql+pymysql://alddle_user:your_password_here@db:3306/alddle_db?charset=utf8mb4

# Firebase Admin (서버 전용)
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_UIDS=
# 비밀키는 프로젝트 외부 파일에 저장. 아래 경로를 Docker에 읽기 전용으로 마운트합니다.
FIREBASE_CREDENTIALS_DIR=./secrets
GOOGLE_APPLICATION_CREDENTIALS=/run/firebase/service-account.json
